#!/usr/bin/env bash
set -euo pipefail

command_name="${1:-openclaw}"
if [[ $# -gt 0 ]]; then shift; fi

if [[ -z "${BIONEMO_MCP_API_KEY:-}" && -n "${CLAWBIO_API_KEY:-}" ]]; then
  export BIONEMO_MCP_API_KEY="$CLAWBIO_API_KEY"
fi

case "$command_name" in
  openclaw|server)
    exec node /opt/bionemo/runtime/launcher.mjs "$@"
    ;;
  codex)
    node /opt/bionemo/runtime/prepare-clients.mjs
    exec codex "$@"
    ;;
  claude)
    node /opt/bionemo/runtime/prepare-clients.mjs
    exec claude "$@"
    ;;
  doctor)
    exec node /opt/bionemo/runtime/doctor.mjs "$@"
    ;;
  help|-h|--help)
    cat <<'EOF'
BioNeMo Agent Workbench

Usage:
  bionemo-agent openclaw   Start the authenticated Serverless browser agent
  bionemo-agent codex      Start Codex CLI (user authentication required)
  bionemo-agent claude     Start Claude Code (user authentication required)
  bionemo-agent doctor     Report installed agents and configured capabilities

No model-provider, MCP, Tavily, Anthropic, or OpenAI credential is stored in
this image. Supply credentials only through runtime environment variables.
EOF
    ;;
  *)
    echo "Unknown BioNeMo agent command: $command_name" >&2
    exit 64
    ;;
esac
