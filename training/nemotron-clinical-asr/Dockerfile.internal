# Qualified CUDA 12.8 NeMo runtime; no floating image tags.
ARG BASE_IMAGE=cr.eu-north1.nebius.cloud/e00akg9ndpx77eaexh/fs2-models/nemotron-speech/multilingual@sha256:628c1ffdb68c6e510de5a691432b4da9a6f64941ce5f35c57213ad8cea8b7205
FROM ${BASE_IMAGE}
USER root
RUN python -m pip install --no-cache-dir mcp==1.26.0 boto3==1.42.49
WORKDIR /opt/clinical-asr
COPY clinical_asr ./clinical_asr
ENV PYTHONPATH=/opt/clinical-asr PYTHONUNBUFFERED=1 TORCHINDUCTOR_COMPILE_THREADS=1 HF_HUB_OFFLINE=0
RUN mkdir -p /output /cache /data/clinical-speech && chown -R 10001:10001 /opt/clinical-asr /output /cache /data/clinical-speech
USER 10001:10001
EXPOSE 8000
ENTRYPOINT ["python", "-m", "clinical_asr"]
CMD ["serve"]
